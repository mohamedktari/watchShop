# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/watchshop

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (hebergement des photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email de notification (Gmail avec mot de passe d'application)
GMAIL_USER=votre.email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
ADMIN_NOTIFICATION_EMAIL=votre.email@gmail.com

# Serveur
PORT=4000
CLIENT_URL=http://localhost:4200

# Compte admin cree automatiquement au premier demarrage si aucun admin n'existe
SEED_ADMIN_EMAIL=admin@watchshop.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NOM=Admin
