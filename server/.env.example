# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/watchshop

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (hebergement des photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email de notification (Gmail avec mot de passe d'application)
GMAIL_USER=votre.email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
ADMIN_NOTIFICATION_EMAIL=votre.email@gmail.com

# Serveur
# PORT n'est utilise qu'en local (npm run dev) - Vercel gere le port lui-meme en serverless.
PORT=4000
# Liste d'origines autorisees separees par des virgules (CORS). Inclure le/les domaine(s)
# du frontend en production + localhost pour le dev local.
CLIENT_URL=http://localhost:4200,https://watch-shop-watchshop.vercel.app

# Compte admin cree automatiquement au premier demarrage si aucun admin n'existe
SEED_ADMIN_EMAIL=admin@watchshop.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NOM=Admin
